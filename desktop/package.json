{
  "name": "metriq-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Metriq desktop app — links a project, drafts prompts, and analyzes them against the real codebase before you send them to Claude, ChatGPT, Cursor, or VS Code.",
  "main": "src/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "package:mac": "electron-builder --mac --dir"
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^25.1.8"
  },
  "license": "MIT",
  "build": {
    "appId": "app.metriq.desktop",
    "productName": "Metriq",
    "files": ["src/**/*", "renderer/**/*", "package.json"],
    "extraResources": [{ "from": "../packages/core", "to": "packages/core" }],
    "mac": {
      "icon": "renderer/assets/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": "dir"
    }
  }
}
